# ─── OAuth 2.1 self-hosted authorization server ──────────────────────────────
# Master gate. Leave "false" until the keys + DB migration + frontend work
# are all in place; flipping to "true" mounts /oauth/* and /.well-known/*.
OAUTH_ENABLED=false
# Public origin under which the OAuth endpoints are reachable. MUST exactly
# match what maglo-service has in MCP_OAUTH_ISSUER_URL (no trailing slash).
OAUTH_ISSUER_URL=https://int-console-service.makunaiglobal.ai/console-service/v1
# Audience claim stamped into issued access tokens and surfaced via
# /.well-known/oauth-protected-resource. Defaults to maglo /mcp under the
# issuer when blank.
OAUTH_RESOURCE_URL=https://int-maglo-service.makunaiglobal.ai/maglo-service/v1/mcp
# Directory holding RSA private keys for JWT signing. Filename minus
# extension is used as JWT `kid`. Generate the first one with:
#   openssl genrsa -out oauth-rs256-1.pem 2048 && chmod 600 oauth-rs256-1.pem
OAUTH_SIGNING_KEY_PATH=/secrets/oauth-keys
# Token TTLs (seconds).
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
OAUTH_AUTH_CODE_TTL_SECONDS=600
OAUTH_AUTHORIZE_REQUEST_TTL_SECONDS=600
# DCR abuse guards.
OAUTH_REGISTRATION_ENABLED=true
OAUTH_REGISTRATION_RATE_PER_IP_PER_HOUR=30
OAUTH_REGISTRATION_RATE_GLOBAL_PER_HOUR=1000
# Dev-only: allow http://127.0.0.1 redirect URIs at registration time.
OAUTH_ALLOW_LOCAL_REDIRECT=false
# SPA URLs the browser is bounced to when login or consent is required
# during /oauth/authorize. The frontend reads ?oauth_request_id off these
# URLs and POSTs to /oauth/authorize/continue after login or to
# /oauth/consent/decision after the user picks Allow / Cancel.
OAUTH_LOGIN_REDIRECT_URL=https://int-console-ui.makunaiglobal.ai/login
OAUTH_CONSENT_REDIRECT_URL=https://int-console-ui.makunaiglobal.ai/oauth/consent
